&control
   calculation = 'nscf'
   prefix = 'cbn'
   outdir = './'
   wf_collect = .true.
   pseudo_dir = '../../pseudo'
   verbosity = 'high'
/
&system
   ibrav = 2
   celldm(1) = 6.767372434
